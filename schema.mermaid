graph TD
    subgraph "Исходные данные и компоненты"
        A["webforge.json <br> Единый источник правды: <br> Структура сайта, данные страниц, <br> глобальные настройки (тема, навигация)"]
        B["components/ <br> PHP-компоненты, <br> JSON-данные компонентов, <br> локальный JS, CSS"]
        C["layouts/ <br> PHP-макеты страниц"]
    end

    subgraph "Фаза генерации сайта для разработки"
        A --> D{"webforge_php_generator.php <br> (Скрипт-генератор PHP-сайта)"}
        B --> D
        C --> D
        D --> E["_dev_site/ <br> (Сгенерированный PHP-сайт <br> для разработки)"]
    end

    subgraph "Процесс разработки (Локальный PHP-сервер)"
        E --> F(("<br>PHP-сервер <br> для локальной разработки и отладки<br>"))
    end

    subgraph "Процесс сборки (Статическая генерация)"
        F -- "Обход и захват HTML" --> G{"build.php <br> (Скрипт статической сборки)"}
        G --> H["Генерация <br> статического HTML-контента"]
        G --> I["Объединение и <br> минимизация CSS"]
        G --> J["Объединение и <br> минимизация JS"]
    end

    subgraph "Финальный результат (папка /build)"
        H --> K["build/index.html <br> и другие .html файлы"]
        I --> L["build/style.min.css"]
        J --> M["build/script.min.js"]
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style E fill:#ccf,stroke:#333,stroke-width:2px
    style F fill:#9cf,stroke:#333,stroke-width:2px
    style G fill:#ffc,stroke:#333,stroke-width:2px
    style K fill:#cfc,stroke:#333,stroke-width:2px
    style L fill:#cfc,stroke:#333,stroke-width:2px
    style M fill:#cfc,stroke:#333,stroke-width:2px
